# ==============================================================================
# PAYGUARD SOC — Environment Configuration Template (.env.example)
#
# NOTE: All financial values and thresholds in this file are strictly synthetic
# lab parameters denominated in Indian Rupees (INR - ₹).
# This application is entirely local-first and does not connect to any real-world
# payment gateways, banking networks, or financial institutions.
# ==============================================================================

# Core System
PAYGUARD_APP_NAME="PAYGUARD-SOC-Core"
PAYGUARD_ENVIRONMENT="synthetic-lab"
PAYGUARD_DEBUG=false

# Currency Modeling (Strictly INR)
PAYGUARD_SYNTHETIC_CURRENCY="INR"
PAYGUARD_SYNTHETIC_CURRENCY_SYMBOL="₹"

# Database & SQLite Configuration
PAYGUARD_DATABASE_PATH="payguard_synthetic.db"
PAYGUARD_SQLITE_BUSY_TIMEOUT_MS=5000

# Network Isolation (Blocks all external sockets & DNS queries)
PAYGUARD_ENFORCE_NETWORK_ISOLATION=true

# API Security Gateways & Tolerances
PAYGUARD_TIMESTAMP_SKEW_TOLERANCE_SECONDS=300
PAYGUARD_NONCE_CACHE_TTL_SECONDS=600

# Deterministic Fraud Detection Rules (Configurable Lab Parameters)
# DET-01: Micro-Value Probe followed by High-Value Transfer
PAYGUARD_MICRO_VALUE_MAX_INR=50.00
PAYGUARD_HIGH_VALUE_MIN_INR=5000.00
PAYGUARD_MICRO_PROBE_WINDOW_SECONDS=300

# DET-02: New Beneficiary & Velocity Spike
PAYGUARD_VELOCITY_MAX_TX_COUNT=3
PAYGUARD_VELOCITY_WINDOW_SECONDS=60

# DET-04: API Authentication Brute-Force & Stuffing
PAYGUARD_AUTH_FAILURE_BURST_LIMIT=3
PAYGUARD_AUTH_FAILURE_WINDOW_SECONDS=60

# Evidence & Audit Vault
PAYGUARD_EVIDENCE_DIR="evidence"
PAYGUARD_EVIDENCE_HMAC_SECRET="synthetic-lab-evidence-hmac-key-2026-inr"
